<?xml version="1.0" encoding="utf-8"?>
<!--
    Template. ${PRODUCT_NAME} and ${BUNDLE_ID} are substituted at build time
    from the environment (see .env.example); the rendered copy is written to
    packages/distribution.xml.
-->
<installer-gui-script minSpecVersion="1">

    <title>${PRODUCT_NAME}</title>

    <options customize="never"/>

    <choices-outline>
        <line choice="default"/>
    </choices-outline>

    <choice id="default" title="${PRODUCT_NAME}">
        <pkg-ref id="${BUNDLE_ID}"/>
    </choice>

    <pkg-ref id="${BUNDLE_ID}">component.pkg</pkg-ref>

</installer-gui-script>
