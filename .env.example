# Settings for ./build.sh --notarize. Unsigned builds (--dmg, --pkg, --exe on their own) need nothing.
# Copy to .env, uncomment what you use and fill it in, then: source .env && ./build.sh --dmg --notarize
# The plugin's name, version and bundle ID come from the bundles in packaging/input/, not from here.

# --- Signing, for --dmg --notarize and --pkg --notarize ---------------------
# Signs the plugins, the installer app and the .dmg
# (list yours with: security find-identity -v -p codesigning)
# export SIGNING_IDENTITY_APP="Developer ID Application: Acme Audio Ltd (AB12CD34EF)"

# --- Signing, for --pkg --notarize only -------------------------------------
# Needs a Developer ID Installer certificate; --dmg doesn't
# export SIGNING_IDENTITY_INSTALLER="Developer ID Installer: Acme Audio Ltd (AB12CD34EF)"

# --- Notarisation login, for --notarize: set ONE of the two options ---------
# If both are set, KEYCHAIN_PROFILE wins.

# Option 1: Apple ID and an app-specific password
# (make one at appleid.apple.com > Sign-In and Security > App-Specific Passwords)
# export APPLE_ID="dev@acme-audio.com"
# export APPLE_TEAM_ID="AB12CD34EF"
# export APPLE_APP_PASSWORD="abcd-efgh-ijkl-mnop"

# Option 2: a keychain profile, so no password in this file. Create it once
# ("acme-notary" is any name you choose):
#   xcrun notarytool store-credentials "acme-notary" \
#     --apple-id "dev@acme-audio.com" --team-id "AB12CD34EF" --password "abcd-efgh-ijkl-mnop"
# export KEYCHAIN_PROFILE="acme-notary"

# Development overrides (INSTALLER_APP, INSTALLER_EXE) don't belong here: set them on the
# command line for one build (see README > Settings), or they stick.
