# Signing and notarisation settings only, all for --notarize. Unsigned builds need nothing here.
# The plugin's name, version and bundle ID are read from the bundles in plugin-binaries/.

# ---------------------------------------------------------------------------
# Signing identity: signs the plugins, the installer app and the .dmg
# (find yours with: security find-identity -v -p codesigning)
# ---------------------------------------------------------------------------
export SIGNING_IDENTITY_APP="Developer ID Application: Your Name (TEAMID)"

# Only for --pkg --notarize, which needs a Developer ID Installer certificate
# export SIGNING_IDENTITY_INSTALLER="Developer ID Installer: Your Name (TEAMID)"

# ---------------------------------------------------------------------------
# Notarisation login: pick ONE option. If both are set, KEYCHAIN_PROFILE wins.
# ---------------------------------------------------------------------------

# OPTION 1: Apple ID + app-specific password (simplest)
# Generate the password at https://appleid.apple.com -> Sign-In and Security -> App-Specific Passwords
export APPLE_ID="your@email.com"
export APPLE_TEAM_ID="TEAMID"
export APPLE_APP_PASSWORD="xxxx-xxxx-xxxx-xxxx"

# OPTION 2: keychain profile (more secure: no password in this file)
# Run once; "AC_PASSWORD" is any label you choose:
#   xcrun notarytool store-credentials "AC_PASSWORD" \
#     --apple-id "your@email.com" --team-id "TEAMID" --password "xxxx-xxxx-xxxx-xxxx"
# Then delete the three OPTION 1 lines above and uncomment:
# export KEYCHAIN_PROFILE="AC_PASSWORD"

# Usage:
# 1. cp .env.example .env
# 2. Fill in your values
# 3. source .env && ./build.sh --dmg --notarize
