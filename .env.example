# ---------------------------------------------------------------------------
# Your plugin. REQUIRED
#
# --dmg needs PRODUCT_NAME only. --pkg needs all three.
# ---------------------------------------------------------------------------

# Installer title
export PRODUCT_NAME="My Plugin"

# Package identifier. CHANGE THIS
export BUNDLE_ID="com.yourcompany.myplugin"

export VERSION="0.0.1"


# ---------------------------------------------------------------------------
# Signing certificates (only needed for --notarize)
# ---------------------------------------------------------------------------

export SIGNING_IDENTITY_APP="Developer ID Application: Your Name (TEAMID)"
export SIGNING_IDENTITY_INSTALLER="Developer ID Installer: Your Name (TEAMID)"
export APPLE_ID="your@email.com"
export APPLE_TEAM_ID="TEAMID"


# ---------------------------------------------------------------------------
# Notarization password -- pick ONE of the two options below.
# If both are set, KEYCHAIN_PROFILE wins.
# ---------------------------------------------------------------------------

# OPTION 1: paste the password directly (simplest)
#
# Generate one at https://appleid.apple.com -> Security -> App-Specific Passwords
#
export APPLE_APP_PASSWORD="xxxx-xxxx-xxxx-xxxx"


# OPTION 2: store the password in the macOS keychain (more secure)
#
#
# Run this ONCE in your terminal. "AC_PASSWORD" is just a label you choose --
# it saves your Apple ID, team ID and password together under that name:
#
#   xcrun notarytool store-credentials "AC_PASSWORD" \
#     --apple-id "your@email.com" \
#     --team-id "TEAMID" \
#     --password "xxxx-xxxx-xxxx-xxxx"
#
# Then comment out APPLE_APP_PASSWORD above, and uncomment this line, passing
# the same label you chose:
#
# export KEYCHAIN_PROFILE="AC_PASSWORD"


# Usage:
# 1. cp .env.example .env
# 2. Fill in your values
# 3. source .env && ./build.sh --dmg --notarize
